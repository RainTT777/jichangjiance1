---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = '2026 稳定翻墙机场排行榜 & 机场数据检测中心 - 实时网络质量评估', canonical } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <!-- Tailwind CSS CDN Fallback & Config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                50: '#eff6ff',
                100: '#dbeafe',
                500: '#3b82f6',
                600: '#2563eb',
                700: '#1d4ed8',
                900: '#0f172a',
              }
            }
          }
        }
      }
    </script>
    <style>
      svg { max-width: 100%; }
      img { max-width: 100%; }
    </style>
  </head>
  <body class="bg-[#F8FAFC] text-slate-900 antialiased min-h-screen">
    <slot />
  </body>
</html>
