---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const { title, description = '2026 稳定翻墙机场排行榜 & 机场数据检测中心 - 实时网络质量评估', canonical } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Tailwind CSS CDN Fallback & Config (Preserved in static HTML) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: {
                50: '#eff6ff',
                100: '#dbeafe',
                500: '#3b82f6',
                600: '#2563eb',
                700: '#1d4ed8',
                900: '#0f172a',
              },
              brand: {
                50: '#eff6ff',
                100: '#dbeafe',
                500: '#3b82f6',
                600: '#2563eb',
                700: '#1d4ed8',
                900: '#0f172a',
              }
            }
          }
        }
      }
    </script>
    <style is:inline>
      svg { max-width: 100%; }
      img { max-width: 100%; }
    </style>
  </head>
  <body class="bg-[#F4F6F9] text-slate-800 antialiased min-h-screen bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-100/60 via-[#F4F6F9] to-[#F4F6F9]">
    <slot />
  </body>
</html>
