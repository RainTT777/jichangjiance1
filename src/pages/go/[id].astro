---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { redirectsData, type RedirectItem } from '../../data/redirects';

export async function getStaticPaths() {
  const ids = Object.keys(redirectsData);
  return ids.map((id) => ({
    params: { id },
    props: { item: redirectsData[id] },
  }));
}

export interface Props {
  item?: RedirectItem;
}

const { id } = Astro.params;
const { item } = Astro.props;
---

<LandingLayout
  seo={{
    title: item ? `安全跳转中转 - ${item.name}` : "未找到目标跳转页面",
    noindex: true,
  }}
>
  <div class="max-w-2xl mx-auto px-4 py-16">
    {item ? (
      <div class="gr-card p-8 sm:p-10 rounded-2xl border border-slate-200 bg-white text-center space-y-5 shadow-xl">
        <div class="w-14 h-14 rounded-2xl bg-black text-white mx-auto flex items-center justify-center text-2xl font-black shadow-md">
          🚀
        </div>

        <h1 class="text-2xl sm:text-3xl font-black text-slate-900">
          即将跳转至外部页面：{item.name}
        </h1>

        <p class="text-slate-600 text-sm leading-relaxed max-w-lg mx-auto font-normal">
          {item.description}。您即将离开本站，目标链接为：
          <code class="block mt-2 p-2.5 bg-slate-100 rounded-lg text-rose-600 font-mono text-xs break-all border border-slate-200">
            {item.targetUrl}
          </code>
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            id="jump-btn"
            href={item.targetUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-black hover:bg-slate-800 text-white font-extrabold text-sm shadow-md transition-all"
          >
            立即前往目标网站
          </a>
          <a
            href="/"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-sm transition-all"
          >
            返回首页
          </a>
        </div>

        <p class="text-xs text-slate-400 pt-4 border-t border-slate-100">
          提示：本站外链跳转服务仅用于公开官方资源引流与技术中转，不包含任何商业促销追踪逻辑。
        </p>
      </div>
    ) : (
      <div class="gr-card p-10 rounded-2xl border border-slate-200 bg-white text-center space-y-5">
        <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 mx-auto flex items-center justify-center text-2xl font-black border border-rose-200">
          ⚠️
        </div>
        <h1 class="text-2xl font-black text-slate-900">未找到该跳转 ID</h1>
        <p class="text-slate-500 text-sm">请求的跳转路由 <code>/go/{id}/</code> 不存在或已被注销。</p>
        <a
          href="/"
          class="inline-block px-6 py-3 rounded-xl bg-black text-white font-bold text-sm"
        >
          返回站点首页
        </a>
      </div>
    )}
  </div>
</LandingLayout>
