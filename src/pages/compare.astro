---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const compareData = [
  { name: 'EdgeNova 专线', type: '纯血 IEPL 专线', nodes: '60+', rate: '1.0x 真实扣费', score: '9.8', price: '¥15/月 (折后¥6.5/月)', link: '/reviews/edgenova-2026/' },
  { name: '速界 SpeedWorld', type: '电竞级 IEPL 专线', nodes: '45+', rate: '1.0x 真实扣费', score: '9.6', price: '¥15/月起', link: '/reviews/' },
  { name: '可信云 Kosing', type: 'IEPL 物理专线', nodes: '40+', rate: '1.0x 真实扣费', score: '9.5', price: '¥15/月 (年付¥96起)', link: '/reviews/' },
  { name: '快狸 Kuaili', type: '大带宽优化直连', nodes: '35+', rate: '1.0x 真实扣费', score: '9.4', price: '平民按量价', link: '/reviews/' },
  { name: '云图机场 Yuntu', type: '金融级物理专线', nodes: '50+', rate: '1.0x 真实扣费', score: '9.3', price: '¥22/月起', link: '/reviews/' },
];
---

<BaseLayout
  title="2026 翻墙机场多维度对比分析工具 - 机场指南"
  description="对比 EdgeNova、速界、可信云、快狸、云图等主流机场的线路架构、真实扣费倍率、流媒体/AI 解锁能力与起步资费。"
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">机场多维度对比工具</span>
    </nav>

    <!-- 响应式布局: 中间主区 + 右侧侧栏 -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 主内容区 -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-2">2026 机场多维度参数对比</h1>
          <p class="text-sm sm:text-base text-slate-600 font-medium">帮助您在选购时剔除虚标高倍率机场，精准选择符合自己预算与需求的最佳平台</p>
        </div>

        <!-- 对比数据大表 -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
          <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-lg font-black text-slate-900">主流机场实测指标对比</h2>
            <span class="text-xs text-blue-600 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded font-mono font-bold">2026 最新核验</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs sm:text-sm border-collapse min-w-[650px]">
              <thead>
                <tr class="bg-slate-50 text-slate-900 font-mono border-b border-slate-200">
                  <th class="py-3 px-4 font-extrabold">机场名称</th>
                  <th class="py-3 px-4 font-extrabold">底层线路类型</th>
                  <th class="py-3 px-4 font-extrabold">节点规模</th>
                  <th class="py-3 px-4 font-extrabold">计费与倍率</th>
                  <th class="py-3 px-4 font-extrabold">综合评分</th>
                  <th class="py-3 px-4 font-extrabold">起步资费</th>
                  <th class="py-3 px-4 font-extrabold text-right">评测直达</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 font-semibold text-slate-800">
                {compareData.map((item) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="py-3.5 px-4 font-extrabold text-slate-900">{item.name}</td>
                    <td class="py-3.5 px-4"><span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded border border-blue-200 text-xs font-mono font-bold">{item.type}</span></td>
                    <td class="py-3.5 px-4 font-mono">{item.nodes}</td>
                    <td class="py-3.5 px-4 text-emerald-700 font-mono font-bold">{item.rate}</td>
                    <td class="py-3.5 px-4 font-mono font-black text-blue-600">{item.score} / 10</td>
                    <td class="py-3.5 px-4 font-mono">{item.price}</td>
                    <td class="py-3.5 px-4 text-right">
                      <a href={item.link} class="px-3 py-1.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-2xs transition-all inline-flex items-center gap-1 cursor-pointer no-underline" style="color: #ffffff !important;">
                        <span style="color: #ffffff !important;">阅读评测</span>
                        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

      </section>

      <!-- 右侧侧栏 (Sticky top-20) -->
      <aside class="w-full lg:w-[280px] xl:w-[320px] 2xl:w-[340px] shrink-0 space-y-6 sticky top-20">
        
        <!-- 站长 Profile -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs relative overflow-hidden">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-gradient-to-tr from-blue-600 to-indigo-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-xs">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            </div>
            <div>
              <h4 class="font-extrabold text-slate-900 text-sm">站长 / 测评官</h4>
              <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-700 text-[11px] rounded font-bold border border-blue-200">5年探针实测</span>
            </div>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed mb-3">基于分布式探针全天候对专线连通率与晚高峰吞吐进行实测复核。</p>
          <a href="http://liangxinyun.club/" target="_blank" class="w-full py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs text-center font-bold rounded-xl transition-colors flex items-center justify-center gap-1.5 shadow-2xs" style="color: #ffffff !important; text-decoration: none !important;">
            <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.67-.52.36-1 .54-1.43.53-.47-.01-1.37-.27-2.04-.49-.82-.27-1.47-.42-1.42-.88.03-.24.37-.49 1.02-.75 3.99-1.74 6.66-2.89 8.01-3.46 3.82-1.61 4.61-1.89 5.13-1.9.11 0 .37.03.54.17.14.12.18.28.2.45-.01.07.01.21 0 .26z"/></svg>
            <span style="color: #ffffff !important;">Telegram 频道</span>
          </a>
        </div>

        <!-- 客户端下载 -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
          <h4 class="font-extrabold text-slate-900 text-base mb-3 flex items-center gap-2 border-b border-slate-100 pb-2">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            常用客户端下载
          </h4>
          <div class="space-y-2 text-xs font-semibold">
            <a href="/downloads/" class="flex items-center justify-between p-2.5 bg-slate-50 hover:bg-blue-50 hover:text-blue-600 rounded-xl transition-all border border-slate-100 text-slate-800">
              <span>全平台客户端下载</span>
              <span class="text-xs text-slate-400">下载 →</span>
            </a>
          </div>
        </div>

      </aside>

    </div>

  </main>

  <Footer />
</BaseLayout>
