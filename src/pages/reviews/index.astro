---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const topAirports = [
  {
    name: "EdgeNova",
    logo: "./edgenova_logo.png",
    tagline: "综合梯队首选 / 极速空载红利",
    architecture: "纯全线 IEPL 专线 + VLESS",
    price: "¥15/月 (折后约¥7.2/月)",
    promo: "8折码：xk808",
    rating: "9.8",
    badge: "NO.01 综合首选",
    link: "https://cristyc.edgenovaaff.cc/#/register?code=WWiIvxL9"
  },
