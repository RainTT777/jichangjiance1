>
  <Header />

  <!-- 顶满两端 (Max width 1920px)，中间超宽 -->
  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen">
    
    <!-- 面包屑导航 -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium px-1">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">机场评测文章中心</span>
