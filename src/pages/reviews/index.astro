---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const reviews = await getCollection('reviews');
const sortedReviews = reviews.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="所有评测 - 机场测评">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-8 text-slate-900">所有评测</h1>

    <div class="grid gap-6">
      {sortedReviews.map((review) => (
        <a href={`/reviews/${review.slug}`}
           class="block bg-white rounded-xl shadow-md hover:shadow-xl transition-shadow p-6">
          <div class="flex justify-between items-start gap-4">
            <div class="flex-1">
              <h2 class="text-2xl font-bold mb-2 text-slate-900">
                {review.data.title}
              </h2>
              <p class="text-slate-600 mb-4">
                {review.data.description}
              </p>

              {review.data.tags && (
                <div class="flex flex-wrap gap-2">
                  {review.data.tags.map(tag => (
                    <span class="badge bg-blue-50 text-blue-700">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="flex flex-col items-end gap-2">
              <div class="flex items-center gap-1">
                {Array.from({ length: Math.floor(review.data.score) }).map(() => (
                  <span class="text-yellow-400 text-lg">⭐</span>
                ))}
                <span class="text-lg font-bold text-slate-900 ml-1">
                  {review.data.score.toFixed(1)}
                </span>
              </div>
              <time class="text-sm text-slate-500">
                {new Date(review.data.date).toLocaleDateString('zh-CN')}
              </time>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
