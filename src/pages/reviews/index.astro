  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tabContainer = document.getElementById('review-filter-tabs');
      const articleGrid = document.getElementById('review-articles-grid');
      const countLabel = document.getElementById('visible-article-count');

      if (!tabContainer || !articleGrid) return;

      const buttons = tabContainer.querySelectorAll('button');
      const articles = articleGrid.querySelectorAll('.article-card-item');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedCat = btn.getAttribute('data-category');

          // Highlight button
          buttons.forEach(b => {
            b.className = 'px-3.5 py-2 rounded-xl transition-all border bg-slate-50 text-slate-700 hover:bg-blue-50 hover:text-blue-600 border-slate-200/70';
          });
          btn.className = 'px-3.5 py-2 rounded-xl transition-all border bg-blue-600 text-white font-bold border-blue-600 shadow-xs';

          // Filter articles
          let visibleCount = 0;
          articles.forEach(art => {
            const artCat = art.getAttribute('data-category');
            if (selectedCat === '全部评测文章' || artCat === selectedCat) {
              art.style.display = 'flex';
              visibleCount++;
            } else {
              art.style.display = 'none';
            }
          });

          if (countLabel) countLabel.textContent = visibleCount;
        });
      });
    });
  </script>

