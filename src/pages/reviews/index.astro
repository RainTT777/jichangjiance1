      </div>

      <!-- 3. 可信云 Kosing Cloud -->
      <div id="kexinyun" class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs relative overflow-hidden space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-5">
          <div class="flex items-center gap-4">
            <img src="./kexinyun_logo.png" alt="可信云" class="w-14 h-14 rounded-2xl object-cover border border-slate-200 shadow-md shrink-0" />
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-0.5 bg-emerald-600 text-white text-xs font-bold rounded-md font-mono">不限设备数</span>
                <span class="text-xs text-amber-500 font-bold font-mono">RATING: 9.5 / 10</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mt-1">
