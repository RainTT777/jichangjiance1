---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="关于我们 - 机场指南"
  description="了解机场指南的创建初衷、内容方向和运营理念。"
>
  <Header />

  <main class="py-12 lg:py-16">
    <div class="container-custom max-w-4xl">
      <!-- 面包屑 -->
      <nav class="flex items-center gap-2 text-sm text-slate-600 mb-8">
        <a href="/" class="hover:text-primary-600">首页</a>
        <span>/</span>
        <span class="text-slate-900">关于我们</span>
      </nav>

      <!-- 页面标题 -->
      <div class="mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-4">关于我们</h1>
        <p class="text-lg text-slate-600">了解机场指南的创建初衷和内容方向</p>
      </div>

      <!-- 网站定位 -->
      <section class="card p-8 mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">网站定位</h2>
        <div class="prose prose-slate max-w-none">
          <p class="text-slate-600 leading-relaxed mb-4">
            机场指南是一个专注于提供机场服务相关知识和使用教程的内容平台。我们致力于帮助用户了解和选择适合的网络服务，提供客观、详实的评测和教程内容。
          </p>
          <p class="text-slate-600 leading-relaxed">
            我们的目标是成为用户值得信赖的信息来源，通过专业的内容帮助用户做出明智的选择。
          </p>
        </div>
      </section>

      <!-- 内容方向 -->
      <section class="card p-8 mb-8">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">内容方向</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">新手教程</h3>
              <p class="text-sm text-slate-600">从零开始的入门指南，帮助新手快速上手。</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-slate-900 mb-1">深度评测</h3>
              <p class="text-sm text-slate-600">基于实际使用的客观评测和分析。</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
