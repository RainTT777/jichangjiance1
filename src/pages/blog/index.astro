---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { articles, categories } from '@/data/articles';
---

<BaseLayout
  title="博客文章 - 机场指南"
  description="浏览所有机场相关的教程、评测和使用指南文章。"
>
  <Header />

  <main class="py-12 lg:py-16">
    <div class="container-custom">
      <!-- 页面标题 -->
      <div class="mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-4">博客文章</h1>
        <p class="text-lg text-slate-600">浏览所有教程、评测和使用指南</p>
      </div>

      <div class="grid lg:grid-cols-4 gap-8">
        <!-- 侧边栏分类筛选 -->
        <aside class="lg:col-span-1">
          <div class="card p-6 sticky top-20">
            <h2 class="text-lg font-bold text-slate-900 mb-4">分类筛选</h2>
            <nav class="space-y-2">
              <a
                href="/blog/"
                class="block px-3 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg"
              >
                全部文章
              </a>
              {categories.map(category => (
                <a
                  href={`/category/${category}/`}
                  class="block px-3 py-2 text-sm font-medium text-slate-700 hover:text-primary-600 hover:bg-slate-50 rounded-lg transition-colors"
                >
                  {category}
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <!-- 文章列表 -->
        <div class="lg:col-span-3">
          <div class="mb-6">
            <p class="text-sm text-slate-600">共 {articles.length} 篇文章</p>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            {articles.map(article => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
