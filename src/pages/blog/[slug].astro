---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { articles } from '@/data/articles';

export function getStaticPaths() {
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

// 获取相关文章（同分类的其他文章）
const relatedArticles = articles
  .filter(a => a.category === article.category && a.slug !== article.slug)
  .slice(0, 3);

// 示例FAQ数据
const faqs = [
  {
    question: '这篇教程适合新手吗？',
    answer: '是的，我们的教程都从基础开始讲解，即使是完全的新手也能轻松跟随。'
  },
  {
    question: '配置过程需要多长时间？',
    answer: '通常只需要5-10分钟就能完成基本配置，具体时间取决于您的熟练程度。'
  },
  {
    question: '遇到问题怎么办？',
    answer: '您可以查看文章末尾的常见问题解答，或者通过我们的联系方式寻求帮助。'
  }
];
---

<BaseLayout
  title={`${article.title} - 机场指南`}
  description={article.description}
>
  <Header />

  <main class="py-12 lg:py-16">
    <div class="container-custom max-w-4xl">
      <!-- 面包屑 -->
      <nav class="flex items-center gap-2 text-sm text-slate-600 mb-8">
        <a href="/" class="hover:text-primary-600">首页</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-primary-600">博客</a>
        <span>/</span>
        <a href={`/category/${article.category}/`} class="hover:text-primary-600">{article.category}</a>
        <span>/</span>
        <span class="text-slate-900">{article.title}</span>
      </nav>

      <!-- 文章头部 -->
      <article class="mb-12">
        <header class="mb-8">
          <!-- 分类标签 -->
          <a href={`/category/${article.category}/`} class="inline-block px-3 py-1 text-sm font-medium text-primary-700 bg-primary-50 rounded-full mb-4 hover:bg-primary-100 transition-colors">
            {article.category}
          </a>

          <!-- 标题 -->
          <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-6 leading-tight">
            {article.title}
          </h1>

          <!-- 描述 -->
          <p class="text-xl text-slate-600 mb-6 leading-relaxed">
            {article.description}
          </p>

          <!-- 元信息 -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-slate-600 pb-6 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <span>{article.author}</span>
            </div>
            <span>·</span>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <time datetime={article.publishDate}>
                发布于 {new Date(article.publishDate).toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
            {article.updateDate && (
              <>
                <span>·</span>
                <time datetime={article.updateDate} class="text-slate-500">
                  更新于 {new Date(article.updateDate).toLocaleDateString('zh-CN', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
              </>
            )}
          </div>

          <!-- 标签 -->
          {article.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-6">
              {article.tags.map(tag => (
                <a
                  href={`/tag/${tag}/`}
                  class="px-3 py-1 text-sm text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <!-- 文章正文 -->
        <div class="prose prose-slate prose-lg max-w-none">
          <h2>占位内容：这里是文章正文</h2>

          <p>
            这是一个示例文章页面。在实际使用中，您可以将文章内容存储为Markdown文件，然后使用Astro的内容集合功能来渲染。
          </p>

          <h3>第一节：基础概念</h3>
          <p>
            这里是第一节的内容。您可以添加详细的教程步骤、配置说明或评测数据。
          </p>

          <h3>第二节：详细步骤</h3>
          <p>
            这里是第二节的内容。可以包含代码块、图片、列表等丰富的内容格式。
          </p>

          <ul>
            <li>步骤一：准备工作</li>
            <li>步骤二：下载和安装</li>
            <li>步骤三：配置设置</li>
            <li>步骤四：测试连接</li>
          </ul>

          <h3>第三节：注意事项</h3>
          <p>
            使用过程中需要注意的重要事项和常见问题。
          </p>

          <h3>总结</h3>
          <p>
            文章总结部分，回顾重点内容并提供进一步的建议。
          </p>
        </div>
      </article>

      <!-- FAQ 区域 -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">常见问题</h2>
        <div class="space-y-4">
          {faqs.map(faq => (
            <details class="card group">
              <summary class="px-6 py-4 cursor-pointer list-none flex items-center justify-between">
                <span class="font-semibold text-slate-900">{faq.question}</span>
                <svg class="w-5 h-5 text-slate-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-6 pb-4 text-slate-600 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- 文章底部 CTA -->
      <section class="card p-8 bg-gradient-to-br from-primary-50 to-white mb-12 text-center">
        <h3 class="text-2xl font-bold text-slate-900 mb-4">觉得这篇文章有帮助？</h3>
        <p class="text-slate-600 mb-6">浏览更多相关教程和评测内容</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/blog/" class="btn-primary">
            浏览更多文章
          </a>
          <a href={`/category/${article.category}/`} class="btn-secondary">
            查看同类文章
          </a>
        </div>
      </section>

      <!-- 相关文章 -->
      {relatedArticles.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold text-slate-900 mb-6">相关文章</h2>
          <div class="grid md:grid-cols-3 gap-6">
            {relatedArticles.map(related => (
              <ArticleCard article={related} showExcerpt={false} />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .prose {
    @apply text-slate-700;
  }

  .prose h2 {
    @apply text-2xl font-bold text-slate-900 mt-12 mb-4;
  }

  .prose h3 {
    @apply text-xl font-bold text-slate-900 mt-8 mb-4;
  }

  .prose p {
    @apply mb-4 leading-relaxed;
  }

  .prose ul {
    @apply list-disc list-inside mb-4 space-y-2;
  }

  .prose ol {
    @apply list-decimal list-inside mb-4 space-y-2;
  }

  .prose a {
    @apply text-primary-600 hover:text-primary-700 underline;
  }

  .prose strong {
    @apply font-semibold text-slate-900;
  }

  .prose code {
    @apply px-1.5 py-0.5 bg-slate-100 text-slate-900 rounded text-sm;
  }

  .prose blockquote {
    @apply border-l-4 border-primary-500 pl-4 italic text-slate-600 my-6;
  }
</style>
