---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import LeftSidebar from '@/components/LeftSidebar.astro';
import RightSidebar from '@/components/RightSidebar.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { topics } from '@/data/topics';
import { articles } from '@/data/articles';

export function getStaticPaths() {
  return topics.map(topic => ({
    params: { slug: topic.slug },
    props: { topic }
  }));
}

const { topic } = Astro.props;

// 获取该专题下的文章
const topicArticles = articles.slice(0, 6);
---

<BaseLayout
  title={`${topic.title} - 机场指南专题`}
  description={topic.description}
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <a href="/topics/" class="hover:text-blue-600 transition-colors">专题聚合</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold truncate max-w-xs sm:max-w-md">{topic.title}</span>
    </nav>

    <!-- 响应式三栏布局: 左侧边栏 + 中间主区 + 右侧侧栏 (参考图2 模板) -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 左侧边栏 (图2 模板) -->
      <LeftSidebar />

      <!-- 主区 -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-2">{topic.title}</h1>
          <p class="text-sm sm:text-base text-slate-600 font-medium">{topic.description}</p>
        </div>

        <!-- 专题文章网格 -->
        <div class="space-y-4">
          <h2 class="text-xl font-black text-slate-900 flex items-center justify-between">
            <span>专题精选教程 ({topicArticles.length})</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {topicArticles.map(article => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>

      </section>

      <!-- 右侧侧栏 (图2 模板) -->
      <RightSidebar />

    </div>

  </main>

  <Footer />
</BaseLayout>
