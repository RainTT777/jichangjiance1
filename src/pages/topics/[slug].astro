---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { topics } from '@/data/topics';
import { articles } from '@/data/articles';

export function getStaticPaths() {
  return topics.map(topic => ({
    params: { slug: topic.slug },
    props: { topic }
  }));
}

const { topic } = Astro.props;

// 示例：获取该专题下的文章（实际可根据专题匹配规则）
const topicArticles = articles.slice(0, 6);
---

<BaseLayout
  title={`${topic.title} - 机场指南`}
  description={topic.description}
>
  <Header />

  <main class="py-12 lg:py-16">
    <div class="container-custom">
      <!-- 面包屑 -->
      <nav class="flex items-center gap-2 text-sm text-slate-600 mb-8">
        <a href="/" class="hover:text-primary-600">首页</a>
        <span>/</span>
        <a href="/topics/" class="hover:text-primary-600">专题聚合</a>
        <span>/</span>
        <span class="text-slate-900">{topic.title}</span>
      </nav>

      <!-- 专题头部 -->
      <div class="mb-12">
        <div class="flex items-start gap-6 mb-6">
          {topic.icon && (
            <div class="text-6xl flex-shrink-0">
              {topic.icon}
            </div>
          )}
          <div class="flex-1">
            <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-4">{topic.title}</h1>
            <p class="text-lg text-slate-600 leading-relaxed">{topic.description}</p>
          </div>
        </div>

        <div class="flex items-center gap-4 text-sm text-slate-600">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            {topic.articleCount} 篇文章
          </span>
          <span>·</span>
          <span>持续更新中</span>
        </div>
      </div>

      <!-- 专题介绍 -->
      <section class="mb-12">
        <div class="card p-8">
          <h2 class="text-2xl font-bold text-slate-900 mb-4">专题介绍</h2>
          <div class="prose prose-slate max-w-none">
            <p class="text-slate-600 leading-relaxed mb-4">
              这是一个关于{topic.title}的完整专题，包含从基础概念到进阶技巧的全方位内容。
            </p>
            <p class="text-slate-600 leading-relaxed">
              无论您是初学者还是有经验的用户，都能在这个专题中找到有用的信息和指导。
            </p>
          </div>
        </div>
      </section>

      <!-- 专题文章列表 -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">专题文章</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {topicArticles.map(article => (
            <ArticleCard article={article} />
          ))}
        </div>
      </section>

      <!-- 学习路径建议 -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">推荐学习路径</h2>
        <div class="card p-8">
          <ol class="space-y-4">
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center font-bold flex-shrink-0">
                1
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">基础入门</h3>
                <p class="text-sm text-slate-600">了解基本概念和原理，掌握必要的基础知识。</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center font-bold flex-shrink-0">
                2
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">实践操作</h3>
                <p class="text-sm text-slate-600">跟随教程进行实际操作，完成基本配置。</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center font-bold flex-shrink-0">
                3
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">进阶优化</h3>
                <p class="text-sm text-slate-600">学习高级技巧，优化使用体验。</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-8 h-8 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center font-bold flex-shrink-0">
                4
              </div>
              <div>
                <h3 class="font-bold text-slate-900 mb-1">问题解决</h3>
                <p class="text-sm text-slate-600">掌握常见问题的解决方法，提升故障排查能力。</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <!-- CTA -->
      <section class="card p-8 bg-gradient-to-br from-primary-50 to-white text-center">
        <h3 class="text-2xl font-bold text-slate-900 mb-4">探索更多专题</h3>
        <p class="text-slate-600 mb-6">查看其他主题的系统化内容</p>
        <a href="/topics/" class="btn-primary inline-block">
          浏览所有专题
        </a>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
