---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { categories, getArticlesByCategory } from '@/data/articles';

export function getStaticPaths() {
  return categories.map(category => ({
    params: { category },
    props: { category }
  }));
}

const { category } = Astro.props;
const articles = getArticlesByCategory(category);
---

<BaseLayout
  title={`${category} - 机场指南`}
  description={`浏览所有${category}相关的文章和教程。`}
>
  <Header />

  <main class="py-12 lg:py-16">
    <div class="container-custom">
      <!-- 面包屑 -->
      <nav class="flex items-center gap-2 text-sm text-slate-600 mb-8">
        <a href="/" class="hover:text-primary-600">首页</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-primary-600">博客</a>
        <span>/</span>
        <span class="text-slate-900">{category}</span>
      </nav>

      <!-- 分类标题 -->
      <div class="mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-4">{category}</h1>
        <p class="text-lg text-slate-600">共 {articles.length} 篇文章</p>
      </div>

      <div class="grid lg:grid-cols-4 gap-8">
        <!-- 侧边栏分类列表 -->
        <aside class="lg:col-span-1">
          <div class="card p-6 sticky top-20">
            <h2 class="text-lg font-bold text-slate-900 mb-4">所有分类</h2>
            <nav class="space-y-2">
              <a
                href="/blog/"
                class="block px-3 py-2 text-sm font-medium text-slate-700 hover:text-primary-600 hover:bg-slate-50 rounded-lg transition-colors"
              >
                全部文章
              </a>
              {categories.map(cat => (
                <a
                  href={`/category/${cat}/`}
                  class={`block px-3 py-2 text-sm font-medium rounded-lg transition-colors ${
                    cat === category
                      ? 'text-white bg-primary-600'
                      : 'text-slate-700 hover:text-primary-600 hover:bg-slate-50'
                  }`}
                >
                  {cat}
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <!-- 文章列表 -->
        <div class="lg:col-span-3">
          {articles.length > 0 ? (
            <div class="grid md:grid-cols-2 gap-6">
              {articles.map(article => (
                <ArticleCard article={article} />
              ))}
            </div>
          ) : (
            <div class="card p-12 text-center">
              <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <h3 class="text-xl font-bold text-slate-900 mb-2">暂无文章</h3>
              <p class="text-slate-600">该分类下还没有文章，敬请期待。</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
