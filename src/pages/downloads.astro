---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="客户端下载 - 机场指南"
  description="主流客户端的官方下载地址和安装指南。"
>
  <Header />

  <main class="py-12 lg:py-16">
    <div class="container-custom">
      <!-- 面包屑 -->
      <nav class="flex items-center gap-2 text-sm text-slate-600 mb-8">
        <a href="/" class="hover:text-primary-600">首页</a>
        <span>/</span>
        <span class="text-slate-900">客户端下载</span>
      </nav>

      <!-- 页面标题 -->
      <div class="mb-12">
        <h1 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-4">客户端下载</h1>
        <p class="text-lg text-slate-600">主流客户端的官方下载地址和安装指南</p>
      </div>

      <!-- 说明提示 -->
      <div class="card p-4 mb-8 bg-blue-50 border-blue-200">
        <div class="flex items-start gap-2 text-sm text-blue-900">
          <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p>请从官方渠道下载客户端，确保软件安全。所有链接均为示例，请自行查找官方下载地址。</p>
        </div>
      </div>

      <!-- Windows 客户端 -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Windows 客户端</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">Clash for Windows</h3>
                <p class="text-sm text-slate-600">功能强大，支持规则配置</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/clash-windows-setup/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                版本：示例版本 | 大小：约 20MB
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">V2rayN</h3>
                <p class="text-sm text-slate-600">轻量简洁，易于使用</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                版本：示例版本 | 大小：约 10MB
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- macOS 客户端 -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">macOS 客户端</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">ClashX</h3>
                <p class="text-sm text-slate-600">Mac平台首选客户端</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                版本：示例版本 | 系统：macOS 10.15+
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">V2rayU</h3>
                <p class="text-sm text-slate-600">支持多种协议</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                版本：示例版本 | 系统：macOS 10.15+
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- iOS 客户端 -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">iOS 客户端</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">Shadowrocket</h3>
                <p class="text-sm text-slate-600">小火箭，功能全面</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/ios-shadowrocket-guide/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                需要美区 Apple ID | App Store 付费
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">Quantumult X</h3>
                <p class="text-sm text-slate-600">高级用户首选</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                需要美区 Apple ID | App Store 付费
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Android 客户端 -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Android 客户端</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">Clash for Android</h3>
                <p class="text-sm text-slate-600">安卓平台首选</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.523 15.341c-.486 0-.88-.394-.88-.88s.394-.88.88-.88.88.394.88.88-.394.88-.88.88m-11.046 0c-.486 0-.88-.394-.88-.88s.394-.88.88-.88.88.394.88.88-.394.88-.88.88m5.523-7.973l1.182-2.162c.071-.13.023-.293-.108-.364-.131-.071-.293-.023-.364.108l-1.197 2.19c-1.004-.456-2.12-.71-3.297-.71-1.176 0-2.293.254-3.297.71L3.722 5.15c-.071-.131-.232-.179-.363-.108-.131.071-.179.233-.108.364l1.181 2.162C1.986 8.884 0 11.843 0 15.247h24c0-3.404-1.986-6.363-4.432-7.879"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/android-clients-comparison/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                版本：示例版本 | Android 5.0+
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="text-xl font-bold text-slate-900 mb-2">V2rayNG</h3>
                <p class="text-sm text-slate-600">轻量开源客户端</p>
              </div>
              <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.523 15.341c-.486 0-.88-.394-.88-.88s.394-.88.88-.88.88.394.88.88-.394.88-.88.88m-11.046 0c-.486 0-.88-.394-.88-.88s.394-.88.88-.88.88.394.88.88-.394.88-.88.88m5.523-7.973l1.182-2.162c.071-.13.023-.293-.108-.364-.131-.071-.293-.023-.364.108l-1.197 2.19c-1.004-.456-2.12-.71-3.297-.71-1.176 0-2.293.254-3.297.71L3.722 5.15c-.071-.131-.232-.179-.363-.108-.131.071-.179.233-.108.364l1.181 2.162C1.986 8.884 0 11.843 0 15.247h24c0-3.404-1.986-6.363-4.432-7.879"></path>
                </svg>
              </div>
            </div>
            <div class="space-y-3">
              <a href="/blog/" class="block text-sm text-primary-600 hover:text-primary-700">
                → 查看配置教程
              </a>
              <div class="text-xs text-slate-500">
                版本：示例版本 | Android 5.0+
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 注意事项 -->
      <section class="card p-8 bg-slate-50">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">下载注意事项</h2>
        <div class="prose prose-slate max-w-none">
          <ul class="space-y-3 text-sm text-slate-600">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>请从官方渠道或可信来源下载客户端，避免使用来路不明的安装包</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>iOS 客户端需要使用美区或其他非国区 Apple ID 才能下载</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>下载前请确认您的操作系统版本是否符合客户端要求</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>部分客户端可能需要关闭系统安全设置才能安装</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>建议定期检查并更新到最新版本，以获得更好的使用体验和安全性</span>
            </li>
          </ul>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
