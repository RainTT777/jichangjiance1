---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout
  title="客户端下载 - 2026 翻墙机场客户端全平台官方下载与安装指南"
  description="包含 Windows、macOS、iOS (Shadowrocket) 与 Android (v2rayNG / Clash) 主流客户端的官方下载地址、安装步骤与教程指引。"
>
  <Header />

  <main class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-8 py-6 min-h-screen bg-slate-50/50">
    
    <!-- 面包屑 -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 font-medium px-1 mb-6">
      <a href="/" class="hover:text-blue-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-blue-600 font-semibold">客户端下载中心</span>
    </nav>

    <!-- 响应式布局: 中间主区 + 右侧侧栏 -->
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      
      <!-- 主内容区 -->
      <section class="flex-1 min-w-0 w-full space-y-6">
        
        <!-- Header Banner -->
        <div class="relative w-full bg-gradient-to-br from-blue-50/90 via-indigo-50/60 to-slate-50 border border-blue-200/80 rounded-3xl p-6 sm:p-8 text-slate-800 shadow-xs">
          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 mb-2">全平台客户端下载中心</h1>
          <p class="text-sm sm:text-base text-slate-600 font-medium">整理 2026 最新主流 Clash Verge Rev、Sing-box、Shadowrocket（小火箭）及 v2rayNG 客户端官方与开源渠道指引</p>
          
          <div class="mt-4 p-4 bg-blue-100/70 border border-blue-200 rounded-2xl flex items-start gap-3 text-xs sm:text-sm text-blue-900">
            <svg class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p><strong>安全提示：</strong> 请务必从官方 GitHub Release 或本页列出的正规来源获取客户端，切勿安装第三方打包的修改版/汉化版，以防订阅链接泄露。</p>
          </div>
        </div>

        <!-- Windows 客户端 -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2 h-6 bg-blue-600 rounded-full inline-block"></span>
            <span>Windows 桌面客户端</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-blue-50 text-blue-700 font-mono font-bold text-xs rounded-md border border-blue-200">RECOMMENDED</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">Windows 10 / 11</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">Clash Verge Rev</h3>
                <p class="text-xs text-slate-600 leading-relaxed">新一代开源 Clash 客户端，原生支持 VLESS 协议与 TUN 模式，界面极佳。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-mono font-semibold">开源免费 · 推荐</span>
                <a href="/blog/clash-windows-setup/" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-2xs transition-all inline-flex items-center gap-1 cursor-pointer no-underline" style="color: #ffffff !important;">
                  <span style="color: #ffffff !important;">查看配置教程</span>
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-slate-100 text-slate-700 font-mono font-bold text-xs rounded-md border border-slate-200">CLASSIC</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">Windows 全平台</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">V2rayN</h3>
                <p class="text-xs text-slate-600 leading-relaxed">经典轻量 Windows 客户端，内存占用低，支持 V2Ray、Xray 及 Trojan 协议。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-mono font-semibold">经典轻量 · 推荐</span>
                <a href="/blog/clash-windows-setup/" class="px-4 py-2 bg-slate-100 hover:bg-blue-50 text-slate-800 hover:text-blue-600 font-bold text-xs rounded-xl transition-all border border-slate-200/80 inline-flex items-center gap-1 cursor-pointer">
                  <span>查看配置教程</span>
                </a>
              </div>
            </div>

          </div>
        </div>

        <!-- macOS 客户端 -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2 h-6 bg-indigo-600 rounded-full inline-block"></span>
            <span>macOS 桌面客户端</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 font-mono font-bold text-xs rounded-md border border-indigo-200">MAC PREFERRED</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">macOS 11+ (M1/M2/Intel)</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">Clash Verge Rev (Mac)</h3>
                <p class="text-xs text-slate-600 leading-relaxed">完美适配 Apple Silicon 芯片，支持深色模式与菜单栏一键分流。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-mono font-semibold">支持 M 系列芯片</span>
                <a href="/blog/clash-windows-setup/" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-2xs transition-all inline-flex items-center gap-1 cursor-pointer no-underline" style="color: #ffffff !important;">
                  <span style="color: #ffffff !important;">查看配置教程</span>
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 font-mono font-bold text-xs rounded-md border border-emerald-200">SING-BOX</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">macOS 全平台</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">Sing-box GUI</h3>
                <p class="text-xs text-slate-600 leading-relaxed">新一代通用通用内核客户端，极速握手，内存占用低。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-mono font-semibold">Universal GUI</span>
                <a href="/blog/advanced-rules-config/" class="px-4 py-2 bg-slate-100 hover:bg-blue-50 text-slate-800 hover:text-blue-600 font-bold text-xs rounded-xl transition-all border border-slate-200/80 inline-flex items-center gap-1 cursor-pointer">
                  <span>查看配置教程</span>
                </a>
              </div>
            </div>

          </div>
        </div>

        <!-- iOS 客户端 -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2 h-6 bg-slate-800 rounded-full inline-block"></span>
            <span>iOS (iPhone / iPad) 移动客户端</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-amber-50 text-amber-800 font-mono font-bold text-xs rounded-md border border-amber-200">MUST HAVE</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">需外区 Apple ID</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">Shadowrocket (小火箭)</h3>
                <p class="text-xs text-slate-600 leading-relaxed">iOS 平台最为流行且好用的代理工具，扫码或点击链接一键导入配置。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <a href="/apple-id/" class="text-xs text-blue-600 font-bold hover:underline">没有美区 ID？点击获取 →</a>
                <a href="/blog/ios-shadowrocket-guide/" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-2xs transition-all inline-flex items-center gap-1 cursor-pointer no-underline" style="color: #ffffff !important;">
                  <span style="color: #ffffff !important;">查看小火箭教程</span>
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-purple-50 text-purple-700 font-mono font-bold text-xs rounded-md border border-purple-200">ADVANCED</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">需外区 Apple ID</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">Quantumult X (圈x)</h3>
                <p class="text-xs text-slate-600 leading-relaxed">高级分流与重写脚本工具，适合对网络定制有极高要求的进阶用户。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-mono font-semibold">App Store 购买</span>
                <a href="/blog/ios-shadowrocket-guide/" class="px-4 py-2 bg-slate-100 hover:bg-blue-50 text-slate-800 hover:text-blue-600 font-bold text-xs rounded-xl transition-all border border-slate-200/80 inline-flex items-center gap-1 cursor-pointer">
                  <span>查看配置教程</span>
                </a>
              </div>
            </div>

          </div>
        </div>

        <!-- Android 客户端 -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center gap-2">
            <span class="w-2 h-6 bg-emerald-600 rounded-full inline-block"></span>
            <span>Android 安卓客户端</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 font-mono font-bold text-xs rounded-md border border-emerald-200">ANDROID BEST</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">Android 5.0+</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">v2rayNG</h3>
                <p class="text-xs text-slate-600 leading-relaxed">安卓平台使用最广泛的开源工具，全面支持 VLESS、Trojan 与 VMess 订阅。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-mono font-semibold">完全开源 · 无广告</span>
                <a href="/blog/android-clients-comparison/" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-2xs transition-all inline-flex items-center gap-1 cursor-pointer no-underline" style="color: #ffffff !important;">
                  <span style="color: #ffffff !important;">查看安卓教程</span>
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="px-2.5 py-1 bg-cyan-50 text-cyan-700 font-mono font-bold text-xs rounded-md border border-cyan-200">CLASH ENGINE</span>
                  <span class="text-xs font-mono text-slate-400 font-semibold">Android 6.0+</span>
                </div>
                <h3 class="text-lg font-black text-slate-900 mb-1">FlashClash / Surfboard</h3>
                <p class="text-xs text-slate-600 leading-relaxed">优雅的 Clash 规则图形客户端，支持可视化节点测速与智能应用分流。</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-mono font-semibold">图形化分流规则</span>
                <a href="/blog/android-clients-comparison/" class="px-4 py-2 bg-slate-100 hover:bg-blue-50 text-slate-800 hover:text-blue-600 font-bold text-xs rounded-xl transition-all border border-slate-200/80 inline-flex items-center gap-1 cursor-pointer">
                  <span>查看对比教程</span>
                </a>
              </div>
            </div>

          </div>
        </div>

      </section>

      <!-- 右侧侧栏 (Sticky top-20) -->
      <aside class="w-full lg:w-[280px] xl:w-[320px] 2xl:w-[340px] shrink-0 space-y-6 sticky top-20">
        
        <!-- 站长 Profile -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs relative overflow-hidden">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-gradient-to-tr from-blue-600 to-indigo-600 text-white rounded-xl flex items-center justify-center text-lg font-bold shadow-xs">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            </div>
            <div>
              <h4 class="font-extrabold text-slate-900 text-sm">站长 / 测评官</h4>
              <span class="inline-block px-2 py-0.5 bg-blue-50 text-blue-700 text-[11px] rounded font-bold border border-blue-200">5年探针实测</span>
            </div>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed mb-3">基于分布式探针全天候对专线连通率与晚高峰吞吐进行实测复核。</p>
          <a href="http://liangxinyun.club/" target="_blank" class="w-full py-2 bg-blue-600 hover:bg-blue-500 text-white text-xs text-center font-bold rounded-xl transition-colors flex items-center justify-center gap-1.5 shadow-2xs" style="color: #ffffff !important; text-decoration: none !important;">
            <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.2-.08-.06-.19-.04-.27-.02-.12.02-1.96 1.25-5.54 3.67-.52.36-1 .54-1.43.53-.47-.01-1.37-.27-2.04-.49-.82-.27-1.47-.42-1.42-.88.03-.24.37-.49 1.02-.75 3.99-1.74 6.66-2.89 8.01-3.46 3.82-1.61 4.61-1.89 5.13-1.9.11 0 .37.03.54.17.14.12.18.28.2.45-.01.07.01.21 0 .26z"/></svg>
            <span style="color: #ffffff !important;">Telegram 频道</span>
          </a>
        </div>

        <!-- 热门评测文章直达 -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
          <h4 class="font-extrabold text-slate-900 text-base mb-3 flex items-center justify-between border-b border-slate-100 pb-2">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              深度评测精选
            </span>
            <span class="text-xs text-blue-600 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded font-mono font-bold">REVIEWS</span>
          </h4>
          <div class="space-y-2 text-xs font-semibold">
            <a href="/reviews/edgenova-2026/" class="flex items-center justify-between p-2.5 bg-blue-50/70 hover:bg-blue-100/80 rounded-xl transition-all border border-blue-200/80 text-blue-900 font-bold">
              <span class="truncate">EdgeNova 机场深度实测</span>
              <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded font-mono font-bold">9.8</span>
            </a>
            <a href="/reviews/" class="flex items-center justify-between p-2.5 bg-slate-50 hover:bg-blue-50 hover:text-blue-600 rounded-xl transition-all border border-slate-100 text-slate-800">
              <span>2026 稳定机场排行榜</span>
              <span class="text-xs text-slate-400">查看 →</span>
            </a>
          </div>
        </div>

        <!-- 探针状态 -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs text-slate-800">
          <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
            <span class="text-xs font-mono font-extrabold text-slate-800 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              PROBE_ONLINE
            </span>
            <span class="text-[11px] text-emerald-700 font-mono bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200 font-bold">100% 正常</span>
          </div>

          <div class="space-y-2.5 font-mono text-xs">
            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-semibold">专线连通率:</span>
              <span class="text-emerald-600 font-black text-sm">99.98%</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-semibold">平均延迟:</span>
              <span class="text-blue-600 font-black text-sm">24.5 ms</span>
            </div>
          </div>
        </div>

      </aside>

    </div>

  </main>

  <Footer />
</BaseLayout>
