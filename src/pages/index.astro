                          ))}
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="pt-4 border-t border-slate-100 mt-4 flex items-center justify-between text-xs">
                    <span class="text-slate-500 flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 状态: 节点连通正常 · 探针每30秒更新
                    </span>
                    <a href={ap.link} target="_blank" rel="noopener" class="text-blue-600 hover:text-blue-700 font-semibold flex items-center gap-1">
                      查看完整测速报告 →
                    </a>
                  </div>
                </div>

                {/* 偶数行：Logo在右边 */}
                {!isOdd && (
                  <div class={`md:col-span-4 lg:col-span-4 bg-gradient-to-br ${ap.gradient} text-white p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden order-1 md:order-2`}>
                    <div>
                      <div class="flex items-center justify-between mb-4">
                        <span class="px-2.5 py-1 bg-white/10 text-white border border-white/20 text-[11px] font-bold rounded-md">
                          {ap.badge}
