                          {ap.icon}
                        </div>
                        <div>
                          <h3 class="text-xl font-bold text-white tracking-wide">{ap.name}</h3>
                          <p class="text-xs text-slate-300">{ap.tagline}</p>
                        </div>
                      </div>
                      <p class="text-xs text-slate-300 leading-relaxed mb-4">{ap.desc}</p>
                    </div>

                    <div class="pt-3 border-t border-white/20 flex items-center justify-between gap-2">
                      <span class="text-xs text-slate-300">套餐: <strong class="text-white text-sm">{ap.price}</strong></span>
                      <a href={ap.link} target="_blank" rel="noopener" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold rounded-xl transition-colors shadow-md">
                        直达官网 🚀
                      </a>
                    </div>
                  </div>
                )}

                {/* 数据检测部分 */}
                <div class={`md:col-span-8 lg:col-span-8 p-6 sm:p-8 bg-gradient-to-br from-white to-slate-50/80 flex flex-col justify-between ${!isOdd ? 'order-2 md:order-1' : ''}`}>
                  <div>
