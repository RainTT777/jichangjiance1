                        <span class="text-xs text-slate-300 font-medium">评分: <strong class="text-amber-400">{ap.rating}</strong> / 5.0</span>
                      </div>
                      <div class="flex items-center gap-3 mb-3">
                        <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center text-2xl font-extrabold shadow-lg">
