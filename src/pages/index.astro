                        <div class="w-14 h-14 bg-white/10 rounded-2xl p-1 flex items-center justify-center shadow-lg border border-white/20 overflow-hidden shrink-0">
                          <img src={ap.logo} alt={ap.name} class="w-full h-full object-cover rounded-xl" onerror={`this.onerror=null;this.parentElement.innerHTML='<span class="text-2xl">${ap.icon}</span>';`} />
                        </div>
                        <div>
                          <h3 class="text-xl font-bold text-white tracking-wide">{ap.name}</h3>
                          <p class="text-xs text-slate-300 font-medium">{ap.tagline}</p>
                        </div>
                      </div>
                      <p class="text-xs text-slate-300 leading-relaxed mb-4">{ap.desc}</p>
                    </div>

