                        <div class="text-xl font-extrabold text-emerald-700 mt-1"><span data-metric="ping">{ap.ping}</span> <span class="text-xs">ms</span></div>
                        <div class="text-[11px] text-emerald-600 mt-0.5">{ap.pingStatus}</div>
                      </div>
                      <div class="p-3.5 bg-blue-50 border border-blue-100 rounded-2xl transition-all" data-metric-box="loss">
