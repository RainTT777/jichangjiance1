---
import { heroData } from '../data/homepage';
---

<section class="relative overflow-hidden border-b border-slate-200/80 bg-dot-pattern pt-10 pb-12 md:pt-16 md:pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Left Hero Copy -->
      <div class="lg:col-span-7 space-y-5 text-left">
        
        <!-- Eyebrow Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-rose-50 border border-rose-200 text-rose-600 text-xs font-extrabold tracking-wide shadow-sm">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          <span>{heroData.badge}</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-[1.15]">
          {heroData.title}
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl">
          {heroData.subtitle}
        </p>

        <!-- CTA Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a
            href={heroData.primaryCta.href}
            class="px-6 py-3.5 rounded-xl bg-black hover:bg-slate-800 text-white font-bold text-sm shadow-md transition-all hover:scale-[1.02] active:scale-[0.98]"
          >
            {heroData.primaryCta.text}
          </a>
          <a
            href={heroData.secondaryCta.href}
            class="px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-semibold text-sm transition-all hover:border-slate-400 shadow-sm"
          >
            {heroData.secondaryCta.text}
          </a>
        </div>

        <!-- Mini Feature Badges -->
        <div class="pt-3 flex flex-wrap items-center gap-5 text-xs text-slate-500 font-medium">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            每日探针自动化连通测试
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            晚高峰 4K 视频带宽实测
          </span>
        </div>

      </div>

      <!-- Right GateRank Style Probe Metrics Panel -->
      <div class="lg:col-span-5">
        <div class="gr-card p-6 rounded-2xl border border-slate-200 bg-white shadow-xl space-y-4">
          
          <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
              <h3 class="font-extrabold text-slate-900 text-base">{heroData.card.title}</h3>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-bold border border-emerald-200">
              {heroData.card.status}
            </span>
          </div>

          <!-- 3-Grid Metric Cards -->
          <div class="grid grid-cols-3 gap-3">
            {heroData.card.metrics.map((metric) => (
              <div class="bg-slate-50 p-3 rounded-xl border border-slate-200/80 text-center">
                <div class="text-slate-400 text-[11px] font-semibold">{metric.label}</div>
                <div class="text-lg sm:text-xl font-black text-slate-900 font-mono mt-0.5">{metric.value}</div>
              </div>
            ))}
          </div>

          <!-- Bottom Status Note -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <span class="truncate">{heroData.card.note}</span>
            <a href="/compare/" class="text-rose-600 font-bold hover:underline shrink-0 ml-2">完整榜单 &rarr;</a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
