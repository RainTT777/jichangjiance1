---
import type { Topic } from '@/data/topics';

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
---

<article class="card group">
  <a href={`/topics/${topic.slug}/`} class="block p-6">
    <!-- 图标和标题 -->
    <div class="flex items-start gap-4 mb-4">
      {topic.icon && (
        <div class="text-4xl flex-shrink-0">
          {topic.icon}
        </div>
      )}
      <div class="flex-1">
        <h3 class="text-xl font-bold text-slate-900 group-hover:text-primary-600 transition-colors mb-2">
          {topic.title}
        </h3>
        <p class="text-sm text-slate-600 leading-relaxed line-clamp-2">
          {topic.description}
        </p>
      </div>
    </div>

    <!-- 底部信息 -->
    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
      <span class="text-sm text-slate-500">
        {topic.articleCount} 篇文章
      </span>
      <span class="text-sm font-medium text-primary-600 group-hover:text-primary-700 transition-colors">
        探索专题 →
      </span>
    </div>
  </a>
</article>
