      </div>
      <div>
        <div class="text-xs text-slate-500 font-medium">本次实时检测</div>
        <div class="text-sm font-bold text-slate-800 font-mono" id="lastCheckTime">刚刚已同步</div>
      </div>
    </div>
  </div>

  <!-- Terminal Diagnostics Drawer Console (collapsible) -->
  <div id="diagnosticConsole" class="hidden rounded-2xl bg-slate-950 border border-slate-800 p-4 font-mono text-xs text-slate-300 space-y-3 shadow-2xl">
    <div class="flex items-center justify-between pb-2 border-b border-slate-800">
      <div class="flex items-center gap-2 text-slate-400">
        <span class="w-3 h-3 rounded-full bg-rose-500"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <span class="ml-2 font-bold text-slate-200">Probe Console Terminal v2.6.4</span>
      </div>
      <button id="btnClearConsole" class="text-[11px] text-slate-500 hover:text-slate-300 transition-colors">
        清空日志
      </button>
    </div>
    <div id="consoleLogOutput" class="h-44 overflow-y-auto space-y-1.5 text-slate-300 scrollbar-thin scrollbar-thumb-slate-800">
      <p class="text-slate-500">[SYSTEM] 自动化检测终端初始化就绪。等待触发一键检测...</p>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="gr-card p-4 sm:p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      
      <!-- Category Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0 scrollbar-none" id="filterTabs">
        <button
          type="button"
          data-category="all"
          class="filter-tab active px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all bg-rose-600 text-white shadow-sm"
        >
          🔥 全部机场 (10)
        </button>
        <button
          type="button"
          data-category="iplc"
          class="filter-tab px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all bg-slate-100 text-slate-600 hover:bg-slate-200"
        >
          ⚡ IPLC 专线
        </button>
        <button
          type="button"
          data-category="bgp"
          class="filter-tab px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all bg-slate-100 text-slate-600 hover:bg-slate-200"
        >
          🌐 BGP 多线中转
        </button>
        <button
          type="button"
          data-category="hysteria"
          class="filter-tab px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all bg-slate-100 text-slate-600 hover:bg-slate-200"
        >
          🔮 Hysteria2 / VLESS
        </button>
        <button
          type="button"
          data-category="gaming"
          class="filter-tab px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all bg-slate-100 text-slate-600 hover:bg-slate-200"
        >
          🎮 游戏电竞
        </button>
        <button
          type="button"
          data-category="value"
          class="filter-tab px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all bg-slate-100 text-slate-600 hover:bg-slate-200"
        >
          💰 高性价比 / 新手
        </button>
      </div>

      <!-- Search & Sort Controls -->
      <div class="flex items-center gap-3 shrink-0">
        <div class="relative flex-1 sm:w-56">
          <input
            type="text"
            id="searchInput"
            placeholder="搜索机场名称 / 协议..."
            class="w-full pl-9 pr-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white transition-all"
          />
          <span class="absolute left-3 top-2.5 text-slate-400 text-xs">🔍</span>
        </div>

        <select
          id="sortSelect"
          class="py-2 px-3 rounded-xl border border-slate-200 bg-slate-50 text-xs text-slate-700 font-bold focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white cursor-pointer"
        >
          <option value="rank">默认排名</option>
          <option value="score">综合评分最高</option>
          <option value="ping">延迟最低 (Ping)</option>
          <option value="speed">晚高峰速率最高</option>
          <option value="price">价格最低起</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Airport Detection Cards Grid (每一横排只放 3 个，长方体纵向卡片式) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="airportListContainer">
    {airports.map((airport) => (
      <article
        data-id={airport.id}
        data-category={airport.categoryType}
        data-name={airport.name}
        data-score={airport.score}
        data-ping={airport.ping}
        data-speed={parseInt(airport.speed)}
        data-price={parseFloat(airport.startingPrice.replace('¥', ''))}
        class="airport-card gr-card rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-rose-300 transition-all duration-300 p-5 flex flex-col justify-between space-y-4 relative group h-full"
      >
        <!-- Card Header: Rank Badge, Category, Score & Brand Info -->
        <div class="space-y-3 pb-3 border-b border-slate-100">
          <!-- Top Row: Rank & Badges -->
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <div class={`rank-badge ${airport.rank === 1 ? 'rank-1' : airport.rank === 2 ? 'rank-2' : airport.rank === 3 ? 'rank-3' : 'rank-normal'} shrink-0 text-xs font-black`}>
                {airport.rank}
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-rose-50 text-rose-600 border border-rose-200 truncate">
                {airport.badgeLabel}
              </span>
            </div>

            <div class="flex items-center gap-1 bg-amber-50 px-2.5 py-0.5 rounded-xl border border-amber-200 shrink-0">
              <span class="text-amber-500 font-bold text-xs">⭐</span>
              <span class="font-mono font-black text-amber-800 text-xs">{airport.score}</span>
            </div>
          </div>

          <!-- Brand Logo, Title & Tag -->
          <div class="flex items-start gap-3 pt-1">
            <div class={`w-12 h-12 rounded-2xl bg-gradient-to-br ${airport.logoSvgBg} text-white flex items-center justify-center text-2xl font-black shadow-md shrink-0 transition-transform group-hover:scale-105`}>
              {airport.logoIcon}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h3 class="text-lg font-black text-slate-900 tracking-tight leading-tight group-hover:text-rose-600 transition-colors">{airport.name}</h3>
                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-600">
                  {airport.categoryTag}
                </span>
              </div>
              <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">
                {airport.description}
              </p>
            </div>
          </div>
        </div>

        <!-- Real-Time Probe Metrics (2x2 Grid inside 3-column Vertical Card) -->
        <div class="grid grid-cols-2 gap-2 bg-slate-50/90 p-3 rounded-xl border border-slate-200/80">
          <div class="bg-white p-2 rounded-lg border border-slate-100/90">
            <div class="text-[10px] text-slate-400 font-medium">实时节点状态</div>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-extrabold text-xs text-emerald-700 font-mono">在线 ({airport.uptime})</span>
            </div>
          </div>

          <div class="bg-white p-2 rounded-lg border border-slate-100/90">
            <div class="text-[10px] text-slate-400 font-medium">测速探针延迟 (Ping)</div>
            <div class="font-mono font-black text-slate-900 text-xs mt-0.5 flex items-center gap-1">
              <span class="ping-val">{airport.ping}</span> ms
              <span class="ping-badge px-1 py-0.2 rounded text-[9px] font-bold bg-emerald-100 text-emerald-800">极速</span>
            </div>
          </div>

          <div class="bg-white p-2 rounded-lg border border-slate-100/90">
            <div class="text-[10px] text-slate-400 font-medium">晚高峰测速带宽</div>
            <div class="font-mono font-black text-slate-900 text-xs mt-0.5 truncate">
              {airport.speed}
            </div>
          </div>

          <div class="bg-white p-2 rounded-lg border border-slate-100/90">
            <div class="text-[10px] text-slate-400 font-medium">丢包率 / 节点规模</div>
            <div class="font-mono font-bold text-slate-700 text-[11px] mt-0.5 truncate">
              {airport.loss} · {airport.nodes}+ 节点
            </div>
          </div>
        </div>

        <!-- Capabilities & Tags -->
        <div class="space-y-1.5 text-xs">
          <div class="flex flex-wrap items-center gap-1">
            <span class="text-slate-400 font-semibold text-[10px] shrink-0">流媒体解锁:</span>
            {airport.unlocks.slice(0, 3).map((unlock) => (
              <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold">
                ✓ {unlock}
              </span>
            ))}
          </div>

          <div class="flex flex-wrap items-center gap-1">
            <span class="text-slate-400 font-semibold text-[10px] shrink-0">协议支持:</span>
            {airport.protocols.map((proto) => (
              <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-mono text-[10px]">
                {proto}
              </span>
            ))}
          </div>
        </div>

        <!-- Card Footer: Price & Actions -->
        <div class="pt-3 border-t border-slate-100 space-y-3 mt-auto">
          <div class="flex items-baseline justify-between">
            <span class="text-xs text-slate-400 font-medium">最低资费</span>
            <div class="font-mono font-black text-rose-600 text-lg">
              {airport.startingPrice} <span class="text-xs font-normal text-slate-500">/月起</span>
            </div>
          </div>

          <!-- Package Drawer Toggle -->
          <button
            type="button"
            class="btn-toggle-plans w-full flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-all"
            data-target={`plans-${airport.id}`}
          >
            <span>查看参考套餐价格 ({airport.plans.length}款)</span>
            <span class="arrow-icon transition-transform duration-200 text-[10px]">▼</span>
          </button>

          <!-- Action Buttons Grid -->
          <div class="grid grid-cols-2 gap-2 pt-1">
            <a
              href={airport.reviewUrl}
              class="px-3 py-2.5 rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 text-xs font-bold text-center transition-all bg-slate-50/50 hover:bg-white flex items-center justify-center"
            >
              深度评测
            </a>
            <a
              href={airport.affiliateUrl}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="px-3 py-2.5 rounded-xl bg-gradient-to-r from-rose-500 to-rose-600 hover:from-rose-600 hover:to-rose-700 text-white text-xs font-black shadow-sm text-center transition-all flex items-center justify-center gap-1 group/btn"
            >
              <span>直达官网 / 立即访问</span>
              <span class="transition-transform group-hover/btn:translate-x-0.5">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Collapsible Package Pricing Table -->
        <div id={`plans-${airport.id}`} class="hidden pt-3 border-t border-slate-200/80 bg-slate-50/80 p-3 rounded-xl space-y-2 mt-2">
          <div class="text-[11px] text-slate-600 font-bold border-b border-slate-200 pb-1 flex justify-between">
            <span>套餐名称与配置参考</span>
            <span>资费</span>
          </div>
          <div class="space-y-2">
            {airport.plans.map((plan) => (
              <div class="p-2 bg-white rounded-lg border border-slate-200/80 text-xs space-y-1">
                <div class="flex justify-between items-center">
                  <h4 class="font-extrabold text-slate-900 text-[11px] truncate">{plan.name}</h4>
                  <span class="font-mono font-black text-rose-600 text-[11px] shrink-0 ml-1">{plan.price}</span>
                </div>
                <div class="flex items-center justify-between text-[10px] text-slate-500">
                  <span class="bg-slate-100 px-1 py-0.2 rounded font-mono font-semibold">{plan.traffic}</span>
                  <span class="truncate ml-1">{plan.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Empty state if search returns no results -->
  <div id="noResults" class="hidden text-center py-16 gr-card rounded-2xl bg-white border border-slate-200">
    <div class="text-4xl mb-3">🔍</div>
    <h3 class="text-lg font-bold text-slate-800">未找到匹配的机场</h3>
    <p class="text-xs text-slate-500 mt-1">请尝试更换关键字或选择全部分类</p>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Plan Expand/Collapse Logic
    const planButtons = document.querySelectorAll('.btn-toggle-plans');
    planButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const plansContainer = document.getElementById(targetId);
        const arrow = btn.querySelector('.arrow-icon');
        if (plansContainer) {
          plansContainer.classList.toggle('hidden');
          if (arrow) {
            arrow.classList.toggle('rotate-180');
          }
        }
      });
    });

    // 2. Filter Tabs Logic
    const filterTabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.airport-card');
    const noResults = document.getElementById('noResults');

    let currentCategory = 'all';
    let currentQuery = '';

    function applyFilterAndSearch() {
      let visibleCount = 0;
      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        const name = (card.getAttribute('data-name') || '').toLowerCase();
        const content = card.textContent?.toLowerCase() || '';

        const matchesCat = currentCategory === 'all' || cat === currentCategory;
        const matchesQuery = !currentQuery || name.includes(currentQuery) || content.includes(currentQuery);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => {
          t.classList.remove('active', 'bg-rose-600', 'text-white', 'shadow-sm');
          t.classList.add('bg-slate-100', 'text-slate-600', 'hover:bg-slate-200');
        });
        tab.classList.remove('bg-slate-100', 'text-slate-600', 'hover:bg-slate-200');
        tab.classList.add('active', 'bg-rose-600', 'text-white', 'shadow-sm');

        currentCategory = tab.getAttribute('data-category') || 'all';
        applyFilterAndSearch();
      });
    });

    // 3. Search Input Logic
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        applyFilterAndSearch();
      });
    }

    // 4. Sorting Logic
    const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement | null;
    const container = document.getElementById('airportListContainer');

    if (sortSelect && container) {
      sortSelect.addEventListener('change', () => {
        const value = sortSelect.value;
        const cardArray = Array.from(cards);

        cardArray.sort((a, b) => {
          if (value === 'score') {
            return parseFloat(b.getAttribute('data-score') || '0') - parseFloat(a.getAttribute('data-score') || '0');
          }
          if (value === 'ping') {
            return parseInt(a.getAttribute('data-ping') || '999') - parseInt(b.getAttribute('data-ping') || '999');
          }
          if (value === 'speed') {
            return parseInt(b.getAttribute('data-speed') || '0') - parseInt(a.getAttribute('data-speed') || '0');
          }
          if (value === 'price') {
            return parseFloat(a.getAttribute('data-price') || '999') - parseFloat(b.getAttribute('data-price') || '999');
          }
          // Default rank
          const rankA = parseInt(a.querySelector('.rank-badge')?.textContent || '99');
          const rankB = parseInt(b.querySelector('.rank-badge')?.textContent || '99');
          return rankA - rankB;
        });

        cardArray.forEach(card => container.appendChild(card));
      });
    }

    // 5. Console Terminal Drawer Toggle
    const btnToggleConsole = document.getElementById('btnToggleConsole');
    const diagnosticConsole = document.getElementById('diagnosticConsole');
    const consoleBadge = document.getElementById('consoleBadge');
    const consoleLogOutput = document.getElementById('consoleLogOutput');

    if (btnToggleConsole && diagnosticConsole && consoleBadge) {
      btnToggleConsole.addEventListener('click', () => {
        diagnosticConsole.classList.toggle('hidden');
        if (diagnosticConsole.classList.contains('hidden')) {
          consoleBadge.textContent = 'OFF';
          consoleBadge.classList.replace('text-emerald-400', 'text-rose-400');
        } else {
          consoleBadge.textContent = 'ON';
          consoleBadge.classList.replace('text-rose-400', 'text-emerald-400');
        }
      });
    }

    const btnClearConsole = document.getElementById('btnClearConsole');
    if (btnClearConsole && consoleLogOutput) {
      btnClearConsole.addEventListener('click', () => {
        consoleLogOutput.innerHTML = '<p class="text-slate-500">[SYSTEM] 探针控制台日志已清空。</p>';
      });
    }

    // 6. Interactive Live Re-Test Simulation
    const btnRunFullTest = document.getElementById('btnRunFullTest');
    const testIcon = document.getElementById('testIcon');
    const testBtnText = document.getElementById('testBtnText');
    const testProgressBarContainer = document.getElementById('testProgressBarContainer');
    const testProgressBar = document.getElementById('testProgressBar');
    const testProgressPercent = document.getElementById('testProgressPercent');
    const testStatusLabel = document.getElementById('testStatusLabel');

    function logConsole(msg: string, type: 'info' | 'success' | 'warn' = 'info') {
      if (!consoleLogOutput) return;
      const now = new Date();
      const timeStr = now.toTimeString().split(' ')[0];
      const p = document.createElement('p');
      let colorClass = 'text-slate-300';
      if (type === 'success') colorClass = 'text-emerald-400 font-bold';
      if (type === 'warn') colorClass = 'text-amber-400';

      p.className = `${colorClass} leading-relaxed`;
      p.innerHTML = `<span class="text-slate-500">[${timeStr}]</span> ${msg}`;
      consoleLogOutput.appendChild(p);
      consoleLogOutput.scrollTop = consoleLogOutput.scrollHeight;
    }

    if (btnRunFullTest && testProgressBarContainer && testProgressBar && testProgressPercent && testStatusLabel) {
      let isTesting = false;

      btnRunFullTest.addEventListener('click', () => {
        if (isTesting) return;
        isTesting = true;

        if (testIcon) testIcon.classList.add('animate-spin');
        if (testBtnText) testBtnText.textContent = '正在全站检测中...';
        testProgressBarContainer.classList.remove('hidden');

        // Automatically open console log if closed
        if (diagnosticConsole && diagnosticConsole.classList.contains('hidden')) {
          diagnosticConsole.classList.remove('hidden');
          if (consoleBadge) {
            consoleBadge.textContent = 'ON';
            consoleBadge.classList.replace('text-rose-400', 'text-emerald-400');
          }
        }

        logConsole('🚀 开始对全站 10 大机场执行多节点 TCP & HTTP 延迟握手测试...', 'info');

        let progress = 0;
        const airportNames = ['EdgeNova', '极连云', '光年梯', '云图', '快狸', '极速Cloud', '瞬云', '速界', '寰宇云', '可信云'];

        const interval = setInterval(() => {
          progress += 10;
          testProgressBar.style.width = `${progress}%`;
          testProgressPercent.textContent = `${progress}%`;

          const currentIndex = Math.floor((progress / 100) * airportNames.length) - 1;
          const currentAirport = airportNames[Math.max(0, currentIndex)];

          if (progress <= 30) {
            testStatusLabel.textContent = `[香港 HK-01 探针] 正在测试 ${currentAirport} 节点 TCP 延迟与丢包率...`;
            logConsole(`[HK-01] ${currentAirport} -> SYN ACK 握手成功 (响应: ${(28 + Math.floor(Math.random() * 15))}ms)`, 'success');
          } else if (progress <= 70) {
            testStatusLabel.textContent = `[东京 JP-02 探针] 正在测试 ${currentAirport} 4K 流媒体与 AI 解锁指令...`;
            logConsole(`[JP-02] ${currentAirport} -> Netflix 4K / ChatGPT 解锁检测: 允许`, 'success');
          } else if (progress < 100) {
            testStatusLabel.textContent = `[洛杉矶 US-03 探针] 正在汇总 ${currentAirport} 晚高峰吞吐带宽速率...`;
            logConsole(`[US-03] ${currentAirport} -> 晚高峰峰值带宽测速: ${(750 + Math.floor(Math.random() * 240))} Mbps`, 'info');
          } else {
            clearInterval(interval);
            testStatusLabel.textContent = '全站检测完毕！数据已实时校准。';
            logConsole('✅ 10 大机场全线检测完成！平均连通率 99.6%，平均延迟 41.5ms。', 'success');

            // Randomly micro-adjust ping numbers visually to mimic live test
            cards.forEach(card => {
              const pingEl = card.querySelector('.ping-val');
              if (pingEl) {
                const oldPing = parseInt(pingEl.textContent || '40');
                const diff = (Math.random() * 4 - 2);
                const newPing = Math.max(22, Math.round(oldPing + diff));
                pingEl.textContent = newPing.toString();
              }
            });

            const lastCheckTime = document.getElementById('lastCheckTime');
            if (lastCheckTime) {
              const now = new Date();
              lastCheckTime.textContent = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}:${now.getSeconds().toString().padStart(2, '0')} 已更新`;
            }

            setTimeout(() => {
              if (testIcon) testIcon.classList.remove('animate-spin');
              if (testBtnText) testBtnText.textContent = '重新检测全站机场';
              isTesting = false;
            }, 1000);
          }
        }, 300);
      });
    }
  });
</script>
