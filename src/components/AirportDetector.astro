    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-3 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-semibold tracking-wide">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          自动化探针运行中 · 全网 10 大机场实时连通性监测
        </div>
        
        <h1 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
          全网机场实时连通性与性能检测中心
        </h1>
        
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          基于多地自动化探针 24 小时轮询。即时检测延迟（Ping）、晚高峰带宽（Speed）、丢包率及套餐价格，为您挑选最稳定可靠的网络加速服务。
        </p>
      </div>

      <!-- Action Box -->
      <div class="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0 w-full md:w-auto">
        <button
          type="button"
          id="btnRunFullTest"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-rose-500 to-pink-600 hover:from-rose-600 hover:to-pink-700 text-white font-bold text-sm shadow-lg shadow-rose-500/25 flex items-center justify-center gap-2 transition-all transform active:scale-95"
        >
          <span id="testIcon" class="text-base">⚡</span>
          <span id="testBtnText">一键检测全站机场</span>
        </button>
        <button
          type="button"
          id="btnToggleConsole"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 border border-slate-700/80 text-slate-300 text-xs font-mono font-medium flex items-center justify-center gap-2 transition-all"
        >
          <span>💻 探针诊断控制台</span>
          <span id="consoleBadge" class="px-1.5 py-0.5 rounded bg-slate-700 text-[10px] font-bold text-rose-400">OFF</span>
        </button>
      </div>
    </div>

    <!-- Live Test Progress Bar (hidden by default) -->
    <div id="testProgressBarContainer" class="hidden mt-6 pt-6 border-t border-slate-800/80 space-y-2">
      <div class="flex justify-between text-xs font-mono text-slate-400">
        <span id="testStatusLabel">正在向香港/日本/美国探针节点发送 TCP SYN 握手...</span>
        <span id="testProgressPercent">0%</span>
      </div>
      <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
        <div id="testProgressBar" class="bg-gradient-to-r from-rose-500 to-emerald-400 h-full w-0 transition-all duration-300"></div>
      </div>
    </div>
  </div>

  <!-- Real-Time Metrics Summary Bar -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
    <div class="gr-card p-4 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex items-center gap-3">
