---
const navItems = [
  { label: '机场推荐', href: 'http://liangxinyun.club/' },
  { label: '机场评测', href: 'http://liangxinyun.club/' },
  { label: '客户端教程', href: 'http://liangxinyun.club/' },
  { label: '客户端下载', href: 'http://liangxinyun.club/' },
  { label: 'AI工具推荐', href: 'http://liangxinyun.club/' },
  { label: '流媒体工具', href: 'http://liangxinyun.club/' },
  { label: '免费苹果ID', href: 'http://liangxinyun.club/' },
  { label: '免费节点', href: 'http://liangxinyun.club/' },
  { label: '关于我们', href: 'http://liangxinyun.club/' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Row: Logo & Live Status -->
    <div class="flex items-center justify-between h-16 border-b border-slate-100">
      <!-- Logo & Title -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">机场数据检测中心</span>
            <span class="px-2 py-0.5 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-full flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              实时监控中
            </span>
          </div>
          <p class="text-xs text-slate-500 hidden sm:block">专业节点连通性 / 延迟 / 丢包率 / 解锁数据大盘</p>
        </div>
      </a>

      <!-- Right Control Status & Entry Button -->
      <div class="flex items-center gap-3 text-xs font-medium text-slate-600">
        <div class="hidden md:flex items-center gap-2 px-3 py-1.5 bg-slate-100 rounded-lg">
          <span class="text-slate-400">检测节点数:</span>
          <span class="text-slate-900 font-bold">120+ 节点</span>
        </div>
        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 bg-slate-100 rounded-lg">
          <span class="text-slate-400">刷新频率:</span>
          <span class="text-emerald-600 font-bold">每 30s 自动刷新</span>
        </div>
        <a href="http://liangxinyun.club/" target="_blank" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all shadow-sm shrink-0 flex items-center gap-1.5">
          <span>官网入口</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>

    <!-- Restored Navigation Bar Row (ALWAYS VISIBLE) -->
    <nav class="flex items-center gap-1.5 sm:gap-2 py-2 overflow-x-auto whitespace-nowrap scrollbar-none text-xs sm:text-sm font-semibold">
      {navItems.map(item => (
        <a
          href={item.href}
          target="_blank"
          class="px-3.5 py-1.5 bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-700 rounded-lg transition-all flex items-center gap-1"
        >
          {item.label}
        </a>
      ))}
    </nav>

  </div>
</header>
