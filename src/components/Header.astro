---
const navItems = [
  { label: '机场推荐', href: 'http://liangxinyun.club/' },
  { label: '机场评测', href: 'http://liangxinyun.club/' },
  { label: '客户端教程', href: 'http://liangxinyun.club/' },
  { label: '客户端下载', href: 'http://liangxinyun.club/' },
  { label: 'AI工具推荐', href: 'http://liangxinyun.club/' },
  { label: '流媒体工具', href: 'http://liangxinyun.club/' },
  { label: '免费苹果ID', href: 'http://liangxinyun.club/' },
  { label: '免费节点', href: 'http://liangxinyun.club/' },
  { label: '关于我们', href: 'http://liangxinyun.club/' },
];
---

<header class="sticky top-0 z-50 bg-[#F4F7F2]/95 backdrop-blur-md border-b border-[#4A7C59]/15 shadow-sm">
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Row: Logo & Live Status -->
    <div class="flex items-center justify-between h-16 border-b border-[#4A7C59]/10">
      <!-- Logo & Title -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-10 h-10 bg-gradient-to-br from-[#4A7C59] to-[#3B6645] rounded-xl flex items-center justify-center shadow-md shadow-[#4A7C59]/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl font-bold text-[#2C3E2D] group-hover:text-[#4A7C59] transition-colors">机场数据检测中心</span>
            <span class="px-2.5 py-0.5 text-xs font-semibold bg-[#4A7C59]/10 text-[#4A7C59] border border-[#4A7C59]/20 rounded-full flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#4A7C59] animate-ping"></span>
              实时监控中
            </span>
          </div>
          <p class="text-xs text-[#6B806E] hidden sm:block">专业节点连通性 / 延迟 / 丢包率 / 解锁数据大盘</p>
        </div>
      </a>

      <!-- Right Control Status & Entry Button -->
      <div class="flex items-center gap-3 text-xs font-medium text-[#4A5D4C]">
        <div class="hidden md:flex items-center gap-2 px-3.5 py-1.5 bg-[#EBF1E8] border border-[#4A7C59]/10 rounded-xl">
          <span class="text-[#6B806E]">检测节点数:</span>
          <span class="text-[#2C3E2D] font-bold">120+ 节点</span>
        </div>
        <div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 bg-[#EBF1E8] border border-[#4A7C59]/10 rounded-xl">
          <span class="text-[#6B806E]">刷新频率:</span>
          <span class="text-[#4A7C59] font-bold">每 30s 自动刷新</span>
        </div>
        <a href="http://liangxinyun.club/" target="_blank" class="px-4.5 py-2 bg-gradient-to-r from-[#6C9BCF] to-[#5583B9] hover:from-[#5583B9] hover:to-[#4A72A4] text-white rounded-xl font-semibold transition-all shadow-sm shrink-0 flex items-center gap-1.5">
          <span>官网入口</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
    </div>

    <!-- Restored Navigation Bar Row (ALWAYS VISIBLE) -->
    <nav class="flex items-center gap-1.5 sm:gap-2 py-2 overflow-x-auto whitespace-nowrap scrollbar-none text-xs sm:text-sm font-semibold">
      {navItems.map((item, idx) => (
        <a
          href={item.href}
          target="_blank"
          class={`px-4 py-1.5 rounded-xl transition-all flex items-center gap-1 ${
            idx === 0
              ? 'bg-[#4A7C59]/12 text-[#3B6645] border border-[#4A7C59]/25 font-bold shadow-xs'
              : 'bg-[#EBF1E8]/90 hover:bg-[#4A7C59] hover:text-white text-[#4A5D4C]'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

  </div>
</header>
