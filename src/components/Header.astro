---
import { headerNav } from '../data/nav';
import { siteConfig } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo Mark & Title -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-black flex items-center justify-center text-white font-black text-lg shadow-sm group-hover:scale-105 transition-transform">
          ⚡
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-extrabold text-slate-900 group-hover:text-rose-600 transition-colors tracking-tight">
            {siteConfig.name}
          </span>
        </div>
      </a>

      <!-- GateRank Pill Navigation Menu (Desktop) -->
      <nav class="hidden xl:flex items-center gap-1">
        {headerNav.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`gr-nav-pill ${isActive ? 'is-active' : ''}`}
            >
              <span>{item.title}</span>
              {item.badge && (
                <span class="px-1.5 py-0.2 text-[10px] font-bold rounded bg-rose-600 text-white">
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Action CTA & Mobile Toggle Button -->
      <div class="flex items-center gap-3">
        <a
          href="/compare/"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-black hover:bg-slate-800 text-white font-semibold text-sm shadow-sm transition-all hover:scale-[1.02] active:scale-[0.98]"
        >
          <span>选购对比榜</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="xl:hidden p-2 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-100 focus:outline-none"
          aria-label="打开菜单"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu Panel -->
  <div id="mobile-menu" class="hidden xl:hidden border-b border-slate-200 bg-white/98 backdrop-blur-xl px-4 pt-2 pb-6 shadow-xl">
    <div class="flex flex-col space-y-1">
      {headerNav.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-4 py-2.5 rounded-xl text-sm font-semibold flex items-center justify-between transition-colors ${
              isActive
                ? 'bg-rose-50 text-rose-600 border border-rose-200'
                : 'text-slate-700 hover:bg-slate-100'
            }`}
          >
            <span>{item.title}</span>
            {item.badge && (
              <span class="px-2 py-0.5 text-xs font-bold rounded bg-rose-600 text-white">
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
      <div class="pt-4 border-t border-slate-100">
        <a
          href="/compare/"
          class="w-full py-3 rounded-xl bg-black text-white font-bold text-center block shadow-md"
        >
          查看最新榜单与对比矩阵
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
