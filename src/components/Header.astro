---
const navItems = [
  { label: '机场推荐', href: '/' },
  { label: '机场评测', href: '/reviews/' },
  { label: '客户端教程', href: '/blog/' },
  { label: '客户端下载', href: '/downloads/' },
  { label: 'AI工具推荐', href: '/topics/ai-tools/' },
  { label: '流媒体工具', href: '/topics/streaming-unlock/' },
  { label: '免费苹果ID', href: '/apple-id/' },
  { label: '免费节点', href: '/free-nodes/' },
  { label: '关于我们', href: '/about/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo & Brand Title -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="text-lg font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors tracking-tight">机场数据检测中心</span>
          <span class="px-2 py-0.5 text-[11px] font-semibold bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-full flex items-center gap-1.5 shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
            实时监控
          </span>
        </div>
      </a>

      <!-- Navigation Bar at Top Right (Internal Links, Image 2 Removed) -->
      <nav class="flex items-center gap-1 sm:gap-1.5 overflow-x-auto whitespace-nowrap scrollbar-none text-xs sm:text-sm font-semibold ml-4">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-xl transition-all flex items-center gap-1 ${
                isActive
                  ? 'bg-blue-600 text-white font-bold shadow-sm'
                  : 'text-slate-600 hover:text-blue-600 hover:bg-slate-100'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

    </div>
  </div>
</header>

