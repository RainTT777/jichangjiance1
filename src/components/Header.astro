---
const navItems = [
  { label: '机场推荐', href: 'http://liangxinyun.club/' },
  { label: '机场评测', href: 'http://liangxinyun.club/' },
  { label: '客户端教程', href: 'http://liangxinyun.club/' },
  { label: '客户端下载', href: 'http://liangxinyun.club/' },
  { label: 'AI工具推荐', href: 'http://liangxinyun.club/' },
  { label: '流媒体工具', href: 'http://liangxinyun.club/' },
  { label: '免费苹果ID', href: 'http://liangxinyun.club/' },
  { label: '免费节点', href: 'http://liangxinyun.club/' },
  { label: '关于我们', href: 'http://liangxinyun.club/' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
  <div class="w-full max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo & Title -->
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-xl flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">机场数据检测中心</span>
            <span class="px-2 py-0.5 text-xs font-semibold bg-emerald-100 text-emerald-700 rounded-full flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span>
              实时监控中
            </span>
          </div>
          <p class="text-xs text-slate-500 hidden sm:block">专业节点连通性 / 延迟 / 丢包率 / 解锁数据大盘</p>
        </div>
      </a>

      <!-- Desktop Restored Navigation Bar -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {navItems.map(item => (
          <a
            href={item.href}
            target="_blank"
            class="px-2.5 py-1.5 text-xs xl:text-sm font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right Action Button & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a href="http://liangxinyun.club/" target="_blank" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold transition-all shadow-sm shrink-0">
          官网入口 🚀
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          class="lg:hidden p-2 text-slate-700 hover:bg-slate-100 rounded-lg transition-colors"
          aria-label="打开菜单"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Nav Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white">
    <nav class="w-full max-w-[1920px] mx-auto px-4 py-3 space-y-1">
      {navItems.map(item => (
        <a
          href={item.href}
          target="_blank"
          class="block px-4 py-2 text-sm font-medium text-slate-700 hover:text-blue-600 hover:bg-slate-50 rounded-lg transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
