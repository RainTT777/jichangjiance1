---
export interface Props {
  title: string;
  description: string;
  slug: string;
  count?: number;
  badge?: string;
}

const { title, description, slug, count = 5, badge } = Astro.props;
---

<a
  href={`/topics/${slug}/`}
  class="gr-card gr-card-hover p-6 rounded-2xl border border-slate-200 bg-white flex flex-col justify-between group"
>
  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-100 text-slate-700 border border-slate-200">
        包含 {count} 篇长文
      </span>
      {badge && (
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-600 border border-rose-200">
          {badge}
        </span>
      )}
    </div>

    <h3 class="text-xl font-black text-slate-900 group-hover:text-rose-600 transition-colors">
      {title}
    </h3>

    <p class="text-sm text-slate-600 leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-800 group-hover:text-rose-600">
    <span>进入专题聚合页</span>
    <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </div>
</a>
