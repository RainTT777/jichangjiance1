---
import type { Brand } from '@/data/brands';

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
---

<article class="card group">
  <div class="p-6">
    <!-- 顶部：品牌名和分类 -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <h3 class="text-xl font-bold text-slate-900 group-hover:text-primary-600 transition-colors mb-2">
          {brand.name}
        </h3>
        <span class="inline-block px-3 py-1 text-xs font-medium text-slate-700 bg-slate-100 rounded-full">
          {brand.category}
        </span>
      </div>
    </div>

    <!-- 描述 -->
    <p class="text-sm text-slate-600 leading-relaxed mb-4 line-clamp-2">
      {brand.description}
    </p>

    <!-- 特性标签 -->
    <div class="flex flex-wrap gap-2 mb-4">
      {brand.features.map(feature => (
        <span class="inline-flex items-center gap-1 px-2 py-1 text-xs text-primary-700 bg-primary-50 rounded">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
          </svg>
          {feature}
        </span>
      ))}
    </div>

    <!-- 底部：文章数和查看按钮 -->
    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
      <span class="text-xs text-slate-500">
        {brand.articleCount} 篇相关文章
      </span>
      <a
        href={`/brands/${brand.slug}/`}
        class="text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors"
      >
        查看详情 →
      </a>
    </div>
  </div>
</article>
