---
import type { Brand } from '@/data/brands';

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
---

<article class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md hover:border-blue-300 transition-all p-6 group flex flex-col justify-between">
  <div>
    <!-- 顶部：品牌名和分类 -->
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-base sm:text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors">
        {brand.name}
      </h3>
      <span class="px-2.5 py-1 text-xs font-mono font-bold text-blue-700 bg-blue-50 border border-blue-200 rounded-md">
        {brand.category}
      </span>
    </div>

    <!-- 描述 -->
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3 line-clamp-2">
      {brand.description}
    </p>

    <!-- 特性标签 -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {(brand.pros || []).map(feature => (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs text-blue-700 bg-blue-50/80 border border-blue-200/60 rounded-md font-medium">
          ✓ {feature}
        </span>
      ))}
    </div>
  </div>

  <!-- 底部：文章数和查看按钮 -->
  <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold">
    <span class="text-slate-400 font-mono">
      {brand.articleCount || 3} 篇相关文章
    </span>
    <a
      href={`/brands/${brand.slug}/`}
      class="text-blue-600 font-bold hover:underline flex items-center gap-1"
    >
      <span>查看详情</span>
      <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
    </a>
  </div>
</article>
