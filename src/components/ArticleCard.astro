---
export interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  author?: string;
  featured?: boolean;
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  tags = [],
  author = "机场检测实验室",
  featured = false,
} = Astro.props;

const formattedPubDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class={`gr-card gr-card-hover p-6 rounded-2xl flex flex-col justify-between relative group ${featured ? 'border-rose-200 bg-gradient-to-b from-rose-50/30 to-white' : 'border-slate-200 bg-white'}`}>
  
  <div class="space-y-3">
    <!-- Category & Badge -->
    <div class="flex items-center justify-between gap-2">
      <a
        href={`/category/${category}/`}
        class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-600 border border-rose-200 hover:bg-rose-100 transition-colors"
      >
        {category === 'tutorials' ? '客户端教程' : category === 'evaluation' ? '机场评测' : category}
      </a>
      {featured && (
        <span class="px-2 py-0.5 rounded-md text-[11px] font-black bg-amber-500 text-white shadow-sm">
          🔥 独立精选
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-rose-600 transition-colors leading-snug line-clamp-2">
      <a href={`/blog/${slug}/`}>
        <span class="absolute inset-0"></span>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-slate-600 text-sm leading-relaxed line-clamp-3 font-normal">
      {description}
    </p>
  </div>

  <!-- Footer Metadata -->
  <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-mono">
    <div class="flex items-center gap-2">
      <span class="w-5 h-5 rounded-full bg-black text-white flex items-center justify-center text-[10px] font-black">
        {author.substring(0, 1)}
      </span>
      <span>{author}</span>
    </div>
    <div class="flex items-center gap-2">
      {tags.length > 0 && (
        <span class="text-[11px] text-slate-400 hidden sm:inline">#{tags[0]}</span>
      )}
      <time datetime={pubDate.toISOString()}>
        {formattedPubDate}
      </time>
    </div>
  </div>

</article>
