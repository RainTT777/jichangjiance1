---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const fullItems = [
  { name: '首页', url: '/' },
  ...items
];
---

<nav aria-label="Breadcrumb" class="py-3 text-xs sm:text-sm text-slate-400">
  <ol class="flex items-center flex-wrap gap-1.5">
    {fullItems.map((item, index) => {
      const isLast = index === fullItems.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {index > 0 && <span class="text-slate-600">/</span>}
          {isLast || !item.url ? (
            <span class="text-slate-200 font-medium truncate max-w-[200px] sm:max-w-xs">{item.name}</span>
          ) : (
            <a href={item.url} class="hover:text-teal-300 transition-colors">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<!-- JSON-LD BreadcrumbList -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": fullItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url ? new URL(item.url, Astro.site || 'https://jichangjiance.net').href : undefined
  }))
})} />
